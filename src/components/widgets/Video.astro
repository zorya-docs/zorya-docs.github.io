---
const { src, title } = Astro.props;
---

<div class="flex justify-center py-12 bg-blue-50 dark:bg-transparent">
  <iframe
    src={src}
    title={title}
    frameborder="0"
    allow="autoplay; encrypted-media"
    allowfullscreen
    class="w-full max-w-4xl aspect-video rounded-xl shadow-xl"
  ></iframe>
</div>
